# Environment Configuration for CO-ATTAIN PRO AI
PROJECT_NAME="CO-ATTAIN PRO AI"
VERSION="1.0.0"

# Database Configuration
# Default local SQLite:
DATABASE_URL=sqlite:///./co_attain.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coattain_db

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Settings (Optional - Rule-based engine operates completely offline)
AI_PROVIDER=deterministic
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4o-mini

# Initial Admin Bootstrap (Optional)
BOOTSTRAP_ADMIN_EMAIL=admin@apex.edu
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_NAME=System Administrator
